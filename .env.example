# Clave secreta para Web3Forms / Web3Form.
# Copia este archivo a .env y agrega tu clave real.
WEB3FORMS_KEY=tu_web3forms_key_aqui

# Orígenes permitidos para el endpoint de contacto.
# Ajusta esto al dominio de tu sitio en producción.
ALLOWED_ORIGINS=http://localhost:5173,https://hevca-vue-app.vercel.app/

# Cloudflare Turnstile para un captcha ligero y gratis.
# Deja en blanco si no deseas habilitarlo.
VITE_TURNSTILE_SITE_KEY=tu_turnstile_site_key_aqui
TURNSTILE_SECRET_KEY=tu_turnstile_secret_key_aqui

# Firma HMAC opcional para proteger peticiones de contacto.
# Activa esto sólo si quieres reforzar la validez de las solicitudes.
HMAC_SECRET_KEY=tu_hmac_secret_key_aqui
