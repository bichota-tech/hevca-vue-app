# Clave secreta para Web3Forms / Web3Form.
# Copia este archivo a .env y agrega tu clave real.
WEB3FORMS_KEY=tu_web3forms_key_aqui

# Orígenes permitidos para el endpoint de contacto.
# Ajusta esto al dominio de tu sitio en producción.
ALLOWED_ORIGINS=http://localhost:5173,https://hevca-vue-app.vercel.app/
